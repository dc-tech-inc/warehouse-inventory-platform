# Copy to .env and fill in. Never commit the real file.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Optional
# WEB_DIST=apps/web/dist        # serve the built web app from the API (one origin)
# COOKIE_SECURE=false           # only for plain-HTTP runs; defaults to true in production
# RATE_LIMIT_GLOBAL=300         # requests per 15 min per IP
# RATE_LIMIT_LOGIN=10           # login attempts per 15 min per IP
# SEED_PASSWORD=                # password for the synthetic demo accounts (db:seed, container start)
# SEED_DEMO_DATA=false          # skip demo data on container start
